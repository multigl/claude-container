podman
run
--rm
-v
@STAGE@:/opt/claude-stage:ro
--userns=keep-id:uid=1000,gid=1000
--user
0:0
-e
_CLAUDE_UID_REMAP=skip
--env-file
@ENVFILE@
-e
HOST_UID=@UID@
-e
HOST_GID=@GID@
-e
CLAUDE_HOST_DIR=@PWD@
-v
@PWD@:/workspace
-v
@HOME@/.local/state/claude-container/personal/claude:/home/claude/.claude
-v
@HOME@/.local/state/claude-container/personal/projects/@PROJECT_KEY@:/home/claude/.claude/projects/-workspace
-w
/workspace
@IMAGE@
claude
