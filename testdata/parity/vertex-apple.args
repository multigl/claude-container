container
run
--rm
-v
@STAGE@:/opt/claude-stage:ro
-v
@HOME@/.local/state/claude-container/vertex/creds/gcloud:/home/claude/.config/gcloud
--env-file
@ENVFILE@
-e
HOST_UID=@UID@
-e
HOST_GID=@GID@
-e
CLAUDE_HOST_DIR=@PWD@
-v
@PWD@:/workspace
-v
@HOME@/.local/state/claude-container/vertex/claude:/home/claude/.claude
-v
@HOME@/.local/state/claude-container/vertex/projects/@PROJECT_KEY@:/home/claude/.claude/projects/-workspace
-w
/workspace
@IMAGE@
claude
