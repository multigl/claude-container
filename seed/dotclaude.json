      "hasCompletedProjectOnboarding": true,
      "projectOnboardingSeenCount": 1
    }
  },
  "mcpServers": {
    "atlassian": {
      "type": "stdio",
      "command": "/usr/local/bin/mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "https://vidahealth.atlassian.net",
        "JIRA_USERNAME": "chris.knaplund@vida.com",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "https://vidahealth.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "chris.knaplund@vida.com",
        "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
